# ============================================================================
# Being Seen — 环境变量模板
#
# 用法: 复制成 .env.local 然后填入真实值 (.env.local 已被 .gitignore 忽略)
#   cp .env.example .env.local
#
# 三个变量全部来自 Supabase: Project Settings -> API Keys
# 详细步骤见 DEPLOY.md
#
# 注意:
#   - 只有 NEXT_PUBLIC_ 开头的变量会被打进浏览器代码, 因此它们必须是可公开的。
#   - SUPABASE_SECRET_KEY 绝不能加 NEXT_PUBLIC_ 前缀, 也不能提交到 Git。
#   - 三个变量都不设置时网站依然可以正常浏览, 只是留言板无法保存故事。
# ============================================================================

# 项目 URL, 形如 https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 可公开的 key (新版控制台叫 Publishable key, 旧版叫 anon key)
# 形如 sb_publishable_xxx 或 eyJhbGciOi... (JWT)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅服务端使用的 key (新版控制台叫 Secret key, 旧版叫 service_role key)
# 形如 sb_secret_xxx 或 eyJhbGciOi... (JWT) —— 绝不要泄露
SUPABASE_SECRET_KEY=
