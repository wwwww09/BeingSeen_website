# Supabase — public Message Board
# Only VITE_* variables reach the browser. The publishable key is safe to ship;
# never put a service/secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects may still use the anon key name:
# VITE_SUPABASE_ANON_KEY=

# Server-only variables for Vercel Functions. Never expose these with VITE_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PASSWORD=
# DISCORD_WEBHOOK_URL=
# MODERATION_WEBHOOK_SECRET=
# SITE_URL=
